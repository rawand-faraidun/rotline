# Copy to .env for local development. Dependencies run from the setup templates (postgres, valkey, oauth-mock).

# database: the app connects through PgBouncer, migrations connect directly
DATABASE_URL=postgresql://rotline:<password>@localhost:6440/rotline
DATABASE_DIRECT_URL=postgresql://rotline:<password>@localhost:5440/rotline

# valkey
VALKEY_URL=redis://:<password>@localhost:6390

# api
API_PORT=3100
# public origin of the site; the web dev server proxies /api to the api
PUBLIC_ORIGIN=http://localhost:4321
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# sign-in providers (leave empty to disable a provider)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# fake provider for local development and tests only (never set in production)
AUTH_TEST_PROVIDER_ISSUER=http://localhost:8090/rotline
AUTH_TEST_PROVIDER_CLIENT_ID=rotline-local
AUTH_TEST_PROVIDER_CLIENT_SECRET=rotline-local
