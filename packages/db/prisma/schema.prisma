generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Accounts: the shape Better Auth expects (user, session, account, verification).

model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  sessions      Session[]
  accounts      Account[]
  player        Player?

  @@map("user")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  providerId            String    @map("provider_id")
  accountId             String    @map("account_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verification")
}

// Player profile: one per user, created after the player picks a name.

enum PlayerClass {
  assault
  medic
  heavy

  @@map("player_class")
}

model Player {
  userId      String      @id @map("user_id") @db.Uuid
  name        String
  // lower-cased name, so "Rot" and "rot" cannot both exist
  nameKey     String      @unique @map("name_key")
  avatarStyle String      @map("avatar_style")
  avatarSeed  String      @map("avatar_seed")
  activeClass PlayerClass @default(assault) @map("active_class")
  salvage     BigInt      @default(0)
  isAdmin     Boolean     @default(false) @map("is_admin")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  friendshipsA   Friendship[]   @relation("friendship_a")
  friendshipsB   Friendship[]   @relation("friendship_b")
  blocking       Block[]        @relation("blocking")
  blockedBy      Block[]        @relation("blocked_by")
  recentPlayers  RecentPlayer[] @relation("recent_owner")
  recentlySeenBy RecentPlayer[] @relation("recent_other")

  classes    ClassProgress[]
  skills     SkillAllocation[]
  abilities  AbilitySlot[]
  inventory  InventoryItem[]
  duplicates ItemDuplicate[]
  loadout    Loadout?

  @@map("player")
}

// Progression: per class. Level and skill points are derived from the XP total and the game data.

model ClassProgress {
  playerId String      @map("player_id") @db.Uuid
  class    PlayerClass
  xp       BigInt      @default(0)
  player   Player      @relation(fields: [playerId], references: [userId], onDelete: Cascade)

  @@id([playerId, class])
  @@map("class_progress")
}

model SkillAllocation {
  playerId String      @map("player_id") @db.Uuid
  class    PlayerClass
  // node ids are unique across classes; the class is kept for respec
  nodeId   String      @map("node_id")
  rank     Int
  player   Player      @relation(fields: [playerId], references: [userId], onDelete: Cascade)

  @@id([playerId, class, nodeId])
  @@map("skill_allocation")
}

model AbilitySlot {
  playerId  String      @map("player_id") @db.Uuid
  class     PlayerClass
  slot      Int
  abilityId String      @map("ability_id")
  player    Player      @relation(fields: [playerId], references: [userId], onDelete: Cascade)

  @@id([playerId, class, slot])
  @@map("ability_slot")
}

// Inventory: one copy of each item per player (no rarity). Shared by all classes.

enum ItemSource {
  starter
  shop
  drop

  @@map("item_source")
}

model InventoryItem {
  playerId     String     @map("player_id") @db.Uuid
  itemId       String     @map("item_id")
  upgradeLevel Int        @default(0) @map("upgrade_level")
  // chosen perk ids, one per perk level reached
  perks        String[]   @default([])
  source       ItemSource
  acquiredAt   DateTime   @default(now()) @map("acquired_at") @db.Timestamptz
  player       Player     @relation(fields: [playerId], references: [userId], onDelete: Cascade)

  asMain1    Loadout[] @relation("loadout_main_1")
  asMain2    Loadout[] @relation("loadout_main_2")
  asPistol   Loadout[] @relation("loadout_pistol")
  asArmour   Loadout[] @relation("loadout_armour")
  asUtility1 Loadout[] @relation("loadout_utility_1")
  asUtility2 Loadout[] @relation("loadout_utility_2")

  @@id([playerId, itemId])
  @@map("inventory_item")
}

/// A found copy of an item the player already owns; its only use is to be discarded for Salvage.
model ItemDuplicate {
  id       String   @id @default(uuid(7)) @db.Uuid
  playerId String   @map("player_id") @db.Uuid
  itemId   String   @map("item_id")
  matchId  String?  @map("match_id")
  foundAt  DateTime @default(now()) @map("found_at") @db.Timestamptz
  player   Player   @relation(fields: [playerId], references: [userId], onDelete: Cascade)

  @@index([playerId])
  @@map("item_duplicate")
}

/// What the player takes into a mission; shared by all classes. Points at owned items.
model Loadout {
  playerId String  @id @map("player_id") @db.Uuid
  main1    String  @map("main_1")
  main2    String  @map("main_2")
  pistol   String
  armour   String?
  utility1 String? @map("utility_1")
  utility2 String? @map("utility_2")
  player   Player  @relation(fields: [playerId], references: [userId], onDelete: Cascade)

  main1Item    InventoryItem  @relation("loadout_main_1", fields: [playerId, main1], references: [playerId, itemId], onDelete: Restrict)
  main2Item    InventoryItem  @relation("loadout_main_2", fields: [playerId, main2], references: [playerId, itemId], onDelete: Restrict)
  pistolItem   InventoryItem  @relation("loadout_pistol", fields: [playerId, pistol], references: [playerId, itemId], onDelete: Restrict)
  armourItem   InventoryItem? @relation("loadout_armour", fields: [playerId, armour], references: [playerId, itemId], onDelete: Restrict)
  utility1Item InventoryItem? @relation("loadout_utility_1", fields: [playerId, utility1], references: [playerId, itemId], onDelete: Restrict)
  utility2Item InventoryItem? @relation("loadout_utility_2", fields: [playerId, utility2], references: [playerId, itemId], onDelete: Restrict)

  @@map("loadout")
}

// Economy: every Salvage change is a ledger row, written in the same transaction as what it paid for.

enum LedgerReason {
  kill
  wave
  objective
  mission
  score
  contract
  discard
  purchase
  upgrade
  perk
  respec
  admin

  @@map("ledger_reason")
}

/// Append-only (a trigger rejects UPDATE and DELETE). `player.salvage` is a cache of the running balance.
model LedgerEntry {
  id           BigInt       @id @default(autoincrement())
  // no foreign key: rows outlive a deleted account (re-pointed to a tombstone id)
  playerId     String       @map("player_id") @db.Uuid
  amount       BigInt
  balanceAfter BigInt       @map("balance_after")
  reason       LedgerReason
  refType      String?      @map("ref_type")
  refId        String?      @map("ref_id")
  // makes rewards idempotent: a retried grant cannot pay twice
  grantKey     String?      @unique @map("grant_key")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  purchase     Purchase?

  @@index([playerId, id(sort: Desc)])
  @@map("ledger_entry")
}

model Purchase {
  id            String      @id @default(uuid(7)) @db.Uuid
  playerId      String      @map("player_id") @db.Uuid
  sku           String
  price         BigInt
  ledgerEntryId BigInt      @unique @map("ledger_entry_id")
  ledgerEntry   LedgerEntry @relation(fields: [ledgerEntryId], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([playerId])
  @@map("purchase")
}

/// One row per reward report from a game server; the key makes XP and Salvage grants idempotent.
model RewardGrant {
  grantKey  String      @id @map("grant_key")
  playerId  String      @map("player_id") @db.Uuid
  class     PlayerClass
  xp        BigInt
  salvage   BigInt
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([playerId])
  @@map("reward_grant")
}

// Social: one row per pair, with player_a < player_b so a pair can only exist once.

enum FriendshipStatus {
  pending
  accepted

  @@map("friendship_status")
}

model Friendship {
  playerA     String           @map("player_a") @db.Uuid
  playerB     String           @map("player_b") @db.Uuid
  status      FriendshipStatus
  requestedBy String           @map("requested_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  acceptedAt  DateTime?        @map("accepted_at") @db.Timestamptz
  a           Player           @relation("friendship_a", fields: [playerA], references: [userId], onDelete: Cascade)
  b           Player           @relation("friendship_b", fields: [playerB], references: [userId], onDelete: Cascade)

  @@id([playerA, playerB])
  @@index([playerB, status])
  @@map("friendship")
}

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  blocker   Player   @relation("blocking", fields: [blockerId], references: [userId], onDelete: Cascade)
  blocked   Player   @relation("blocked_by", fields: [blockedId], references: [userId], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("block")
}

/// People a player finished or played a mission with; the newest 50 are kept.
model RecentPlayer {
  playerId String   @map("player_id") @db.Uuid
  otherId  String   @map("other_id") @db.Uuid
  playedAt DateTime @default(now()) @map("played_at") @db.Timestamptz
  owner    Player   @relation("recent_owner", fields: [playerId], references: [userId], onDelete: Cascade)
  other    Player   @relation("recent_other", fields: [otherId], references: [userId], onDelete: Cascade)

  @@id([playerId, otherId])
  @@index([playerId, playedAt(sort: Desc)])
  @@map("recent_player")
}

// Administration

model AdminSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("admin_setting")
}
