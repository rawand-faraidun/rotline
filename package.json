{
	"name": "@rotline/monorepo",
	"description": "Rotline: a browser top-down co-op zombie shooter.",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "turbo run start",
		"prestart": "pnpm db:migrate",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"lint": "biome check .",
		"check": "biome check .",
		"format": "biome format --write .",
		"db:migrate": "pnpm --filter @rotline/db migrate:deploy",
		"verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:integration": "turbo run test:integration",
		"test:e2e": "turbo run test:e2e",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release:tag": "node scripts/tag-release.ts",
		"assets:audio": "pnpm --filter @rotline/assets audio",
		"assets:models": "pnpm --filter @rotline/assets models",
		"assets:characters": "pnpm --filter @rotline/assets characters",
		"assets:thumbnails": "pnpm --filter @rotline/assets thumbnails",
		"assets:textures": "pnpm --filter @rotline/assets textures",
		"assets:props": "pnpm --filter @rotline/assets props"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@changesets/cli": "^3.0.3",
		"@rotline/biome-config": "workspace:*",
		"@rotline/tsconfig": "workspace:*",
		"lefthook": "^2.2.2",
		"turbo": "^2.11.8",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@11.22.0",
	"license": "MIT",
	"author": {
		"name": "Rawand Faraidun",
		"url": "https://github.com/rawand-faraidun"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/rawand-faraidun/rotline.git"
	},
	"homepage": "https://github.com/rawand-faraidun/rotline#readme",
	"bugs": {
		"url": "https://github.com/rawand-faraidun/rotline/issues"
	}
}
